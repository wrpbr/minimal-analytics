{
  "name": "@wrpbr/minimal-analytics-ga4",
  "version": "2.0.0-wrp.1",
  "description": "A small GA4 browser tracker with session, form, navigation and privacy fixes",
  "author": "James Hill <contact@jameshill.dev>",
  "homepage": "https://github.com/wrpbr/minimal-analytics/tree/main/packages/ga4#readme",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/browser.js"
  },
  "sideEffects": true,
  "directories": {
    "lib": "src",
    "test": "tests"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/wrpbr/minimal-analytics/issues"
  },
  "keywords": [
    "ga4",
    "minimal",
    "performance",
    "analytics",
    "lightweight",
    "tracking",
    "google"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrpbr/minimal-analytics.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --workspace-root build",
    "test": "pnpm --workspace-root test"
  },
  "devDependencies": {
    "@minimal-analytics/shared": "workspace:*"
  }
}
